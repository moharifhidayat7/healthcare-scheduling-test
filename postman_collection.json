              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('has token', () => {",
                  "  pm.expect(json.data.register.token).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('authToken', json.data.register.token);",
                  ""
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Register($input: RegisterInput!) {\n  register(input: $input) {\n    token\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"email\": \"{{testEmail}}\",\n    \"password\": \"{{testPassword}}\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
