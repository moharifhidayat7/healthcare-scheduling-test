# Server
PORT=3000
SERVICE_NAME=your-service-name
NODE_ENV=development

# Database — individual
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=your_db_name

# Database — connection string (used by Prisma CLI)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/your_db_name

INTERNAL_JWT_SECRET=change-this-to-a-random-secret
JWT_SECRET=change-this-to-another-random-secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Mail
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_TEMPLATE_DIR=./templates/mail
