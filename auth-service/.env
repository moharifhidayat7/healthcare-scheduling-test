# Server
PORT=3000
SERVICE_NAME=auth-service
NODE_ENV=development

# Database — individual
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_service

# Database — connection string (used by Prisma CLI)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_service

# Auth — Internal
INTERNAL_JWT_SECRET=change-this-to-a-random-secret
JWT_SECRET=change-this-to-a-different-secret

# Redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
