# ─── Compose ───────────────────────────────────────────
COMPOSE_PROJECT_NAME=hss

# ─── PostgreSQL ────────────────────────────────────────
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Redis / BullMQ ────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:${REDIS_PORT}/${REDIS_DB}

# ─── Auth Service ─────────────────────────────────────
JWT_SECRET=change-this-to-a-different-secret
INTERNAL_JWT_SECRET=change-this-to-a-random-secret

# ─── Mail ──────────────────────────────────────────────
MAIL_HOST=smtp4dev
MAIL_PORT=25
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
